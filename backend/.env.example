# Example Environment Variables
# Create a file named .env in the backend folder and copy these variables.

# Unsplash API (Optional - for dummy images)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# Gemini API Key (Required for reasoning & attribute extraction fallback)
GEMINI_API_KEY=your_gemini_api_key

# Groq API Key (Required for LLM query parsing and routing)
GROQ_API_KEY=your_groq_api_key

# Supabase Database URL (Required for connection to Postgres)
DATABASE_URL=postgresql://postgres:ShopWhatYouSee123@db.mxjpueufbooxgewqxccm.supabase.co:5432/postgres

# Admin Dashboard Password (Required to access streamlit dashboard)
DASHBOARD_PASSWORD=swys2026
